{
  "name": "bazar-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "prebuild": "node tools/prepare-public.mjs",
    "build:pages": "node tools/prepare-public.mjs && node tools/build-pages.mjs",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy --keep-vars",
    "connect:api": "node --use-env-proxy tools/connect-api.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "wrangler": "4.92.0"
  }
}
