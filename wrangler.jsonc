{
  "name": "bazar-demo",
  "main": "src/cloudflare.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bazar-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "vars": {
    "PUBLIC_STOREFRONT_ORIGIN": "https://xugushik-source.github.io",
    "BAZAR_OWNER_EMAIL": "owner@bazar.local",
    "BAZAR_PUBLIC_ORIGIN": "https://bazar-demo.xugushik.workers.dev"
  },
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  }
}
